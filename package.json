{
  "name": "madrasehyar",
  "productName": "MadrasehYar",
  "version": "1.0.0",
  "description": "مدرسه‌یار - مدیریت مالی مدرسه (نسخه دسکتاپ، ویندوز ۷ به بالا)",
  "author": "MadrasehYar",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prep": "node scripts/prep.js",
    "dist": "npm run prep && electron-builder --win nsis"
  },
  "dependencies": { "sql.js": "1.8.0" },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "@fontsource-variable/vazirmatn": "5.0.19"
  },
  "build": {
    "appId": "ir.madrasehyar.desktop",
    "productName": "MadrasehYar",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json", "src/**/*"],
    "asarUnpack": ["node_modules/sql.js/dist/*.wasm"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["ia32", "x64"] }],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مدرسه‌یار",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MadrasehYar-Setup-${version}.exe"
    }
  }
}
